diff --git a/conftest.sh b/conftest.sh
new file mode 100644
index 0000000..17ede69
--- /dev/null
+++ b/conftest.sh
@@ -0,0 +1,28 @@
+#!/bin/sh
+# Probe the target kernel's API and print a C header to stdout.
+#
+# Each conftest/<name>.c is a small snippet that compiles only if a kernel
+# feature is present. All probes are compiled in a single Kbuild run, using
+# the target kernel's own flags, and each resulting .o becomes
+# "#define HAVE_<NAME>".
+#
+# A probe can also fail for an unrelated reason (a typo, a missing include)
+# and silently select the wrong code path. Write probes in pairs (old and new
+# API) and #error in the driver when neither or both are present. Compiler
+# output is kept in conftest/conftest.log.
+#
+# Usage: conftest.sh <kernel build dir>
+
+kdir=$1
+dir=$(cd "$(dirname "$0")/conftest" && pwd)
+probes=$(cd "$dir" && ls *.c | sed 's/\.c$/.o/')
+
+rm -f "$dir"/*.o
+make -k -C "$kdir" M="$dir" $probes > "$dir/conftest.log" 2>&1
+
+echo "/* Generated by conftest.sh for $kdir. Do not edit. */"
+for o in $probes; do
+    if [ -f "$dir/$o" ]; then
+        echo "#define HAVE_$(basename "$o" .o | tr a-z A-Z)"
+    fi
+done
diff --git a/conftest/Kbuild b/conftest/Kbuild
new file mode 100644
index 0000000..e4dcec4
--- /dev/null
+++ b/conftest/Kbuild
@@ -0,0 +1,3 @@
+# Probes rely on mismatched pointer types being errors. Recent kernels and
+# compilers already do this; make sure older ones do too.
+ccflags-y += -Werror=incompatible-pointer-types
