+/* scsi_done() replaced the scsi_cmnd->scsi_done callback in 5.16 */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5,16,0)
+#define scsi_done(__scp)     ((__scp)->scsi_done(__scp))
+#endif
